{
  "name": "split",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "icons": "python3 scripts/make-icons.py && npx tauri icon assets/icon-source.png && npx @capacitor/assets generate --android --assetPath assets",
    "e2e": "node scripts/e2e.mjs",
    "seed": "vite-node scripts/seed-demo.ts > /tmp/seed.json",
    "screenshots": "npm run seed && node scripts/screenshots.mjs",
    "licenses": "node scripts/third-party.mjs > THIRD_PARTY_LICENSES.md",
    "version:check": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "puppeteer-core": "^25.14.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cubing": "^0.66.1",
    "ts-fsrs": "^5.4.2"
  },
  "license": "GPL-3.0-or-later",
  "description": "Offline speedcubing timer and algorithm trainer"
}
