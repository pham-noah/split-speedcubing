<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub build only. It is the one that can ask api.github.com for a newer release, so it is the
     one that declares the permission. The `store` flavour has no manifest here and therefore keeps the
     main manifest's promise: no permissions at all, provably offline.

     The permission serves exactly one request: the opt-in update check in Settings. Everything else in
     the app still reads and writes nothing but its own IndexedDB, and a link opens through the phone's
     browser via a Custom Tabs intent, which needs no permission of its own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
